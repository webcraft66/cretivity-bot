# --------------------------------------------------------------------------
# CerevityAI Partnership Assistant - Environment Variables
# In Vercel: Project Settings -> Environment Variables (see README).
# For local testing with `vercel dev`, copy this to ".env" and fill it in.
# --------------------------------------------------------------------------

# Required: Your Gemini API key from Google AI Studio -> https://aistudio.google.com/apikey
GEMINI_API_KEY=your-google-ai-studio-api-key-here

# Optional: Override the Gemini model used by the chatbot (defaults to gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Optional: Cap the response length (defaults to 1024)
GEMINI_MAX_OUTPUT_TOKENS=1024
